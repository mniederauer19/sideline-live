# Copy to your host's environment settings (Render: Environment; Railway / Fly: Variables).
PORT=3000
SEASON=2026

# Seconds between checks: live games (ms) and the scoreboard (ms)
LIVE_POLL_MS=3000
SCOREBOARD_POLL_MS=30000

# 1 = simulated games for testing. Leave unset for real NFL data.
# DEMO=1
# DEMO_PLAY_MS=6000

# Postgres connection string (e.g. free Neon). Keeps accounts, comments, reactions,
# votes, picks and lineups when the host erases its files on restart (Render free plan).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The site's public address; it visits itself every 10 minutes so free hosts don't
# put it to sleep. Render fills this in automatically (RENDER_EXTERNAL_URL).
# KEEP_AWAKE_URL=https://sideline-live.onrender.com

# Where the SQLite database lives. Put it on a persistent disk/volume in production.
# DB_FILE=/data/sideline.db

# Free picks economy
START_CREDITS=1000
PICK_WIN=100
PICK_LOSS=-50

# Weekly salary-cap lineups
SALARY_CAP=50000

# Login: "local" = pick a username on this site; "sideline" = use sidelineff.com accounts
# AUTH_MODE=sideline
# SIDELINE_URL=https://sidelineff.com
# SIDELINE_PROFILE_PATH=/api/profile
# SIDELINE_LOGIN_URL=https://sidelineff.com/login

# Let your main site call this API from the browser (comma separated)
# CORS_ORIGINS=https://sidelineff.com,https://www.sidelineff.com
